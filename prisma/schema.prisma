  ubicacion    Ubicacion   @relation(fields: [empresaId, ubicacionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recepcion__ubicacion")
  recibidaPor  Membresia   @relation(fields: [empresaId, recibidaPorMembresiaId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_recepcion__recibida_por")
