  @@id([empresaId, id])
  @@index([empresaId, ordenId], map: "ix_orden_aprobacion__orden")
  @@index([empresaId, aprobadorMembresiaId], map: "ix_orden_aprobacion__aprobador")
  @@map("orden_aprobacion")
}

model Recepcion {
