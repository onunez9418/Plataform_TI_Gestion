# =============================================================================
# .env.example de la Plataforma de Gestión de Áreas de TI
# Responsable: DevOps. Ver docs/operaciones/plan-entornos-y-costos.md (sección 5).
#
# QUÉ ES ESTE ARCHIVO
#   Lista los NOMBRES de las variables que la plataforma necesita. Todos los
#   valores son de relleno obvio ("cambiar-esto"). NO pongas aquí valores reales.
#
# CÓMO SE USA
#   Desarrollo: copia este archivo a ".env" (que Git ignora) y cambia los valores.
#   Pruebas y producción: los valores reales viven en el almacén de secretos del
#   alojamiento y en los secretos de GitHub, separados por entorno. Nunca en Git.
#
# REGLAS
#   - Cada entorno tiene sus propias claves. Una clave de pruebas no sirve en
#     producción ni al revés.
#   - Estos nombres son una PROPUESTA de DevOps; el Arquitecto los confirma.
#   - Si agregas una variable al código, agrégala aquí el mismo día, sin valor real.
#   - Un secreto publicado por error se considera comprometido: se rota de inmediato.
# =============================================================================

# =============================================================================
# VERSIÓN LOCAL 0.1 (D-119): estas son las variables que usan docker-compose.yml,
# iniciar.bat y "npm run local". Solo datos inventados, solo en la computadora de la persona.
#
#   .env lo CREA SOLO iniciar.bat (scripts/crear-env.ps1) o "node scripts/crear-env.mjs",
#   con contraseñas aleatorias. NO se copia a mano ni se sube a Git (.env está en .gitignore).
#   Estos son los nombres que contiene ese .env (aquí, con valores de relleno):
# =============================================================================
# Superusuario de la base: solo lo usa el servicio "db" para crear los roles; la aplicación no lo recibe.
POSTGRES_PASSWORD=cambiar-esto
# Contraseñas de los roles de la base (A.6.1): dueño de las tablas, aplicación, plataforma, lector de auditoría.
PG_PASS_MIGRACIONES=cambiar-esto
PG_PASS_APP_EMPRESA=cambiar-esto
PG_PASS_APP_PLATAFORMA=cambiar-esto
PG_PASS_LECTOR_AUDITORIA=cambiar-esto
#
# Estas las fija docker-compose.yml / "npm run local" (no hace falta ponerlas en .env):
#   MODO_LOCAL=1                 muestra el enlace de ingreso en pantalla; la aplicación se niega
#                                a arrancar si la base no es local o interna (hosts: db, localhost, 127.0.0.1).
#   ENTORNO=desarrollo, APP_URL=http://localhost:3000
#   DATABASE_URL / PLATFORM_DATABASE_URL / MIGRATION_DATABASE_URL / AUDIT_READER_DATABASE_URL
#                                armadas con las contraseñas de arriba (host "db" en Docker;
#                                localhost:54329 con "npm run local"; DB_PUERTO_LOCAL cambia ese puerto).

# --- Entorno ------------------------------------------------------------------
# Valores permitidos: desarrollo | pruebas | produccion
# La plataforma se niega a arrancar si faltan variables obligatorias, y en
# "produccion" se niega a arrancar si encuentra activas las de reloj o correo de captura.
ENTORNO=desarrollo
# Dirección pública de la aplicación (sin barra final). Los enlaces de los correos la usan.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Base de datos: CINCO roles (D-039.3) -------------------------------------
# Cada rol tiene su propia clave y solo se entrega a quien lo necesita.
# Todas las pruebas de aislamiento corren con app_empresa.

# 1. app_empresa: la aplicación. NO es dueño de tablas, NO es superusuario, NO se
#    salta las reglas por fila. Va por el agrupador de conexiones (modo transacción).
DATABASE_URL=postgres://app_empresa:cambiar-esto@localhost:5432/plataforma_dev
# 1b. app_empresa por conexión directa (sin agrupador), para el proceso trabajador
#     y la cola de trabajos (D-038), que usan funciones que el agrupador no admite.
WORKER_DATABASE_URL=postgres://app_empresa:cambiar-esto@localhost:5432/plataforma_dev
# 2. app_plataforma: solo tablas globales (consola del Administrador de plataforma).
PLATFORM_DATABASE_URL=postgres://app_plataforma:cambiar-esto@localhost:5432/plataforma_dev
# 3. migraciones: dueño de las tablas. SOLO existe en el paso de publicación.
#    Nunca se entrega a la aplicación en funcionamiento.
MIGRATION_DATABASE_URL=postgres://migraciones:cambiar-esto@localhost:5432/plataforma_dev
# 4. mantenimiento: solo archiva o borra por partición (purga de auditoría).
#    Fuera de la aplicación; se usa con dos personas autorizadas y constancia.
MAINTENANCE_DATABASE_URL=postgres://mantenimiento:cambiar-esto@localhost:5432/plataforma_dev
# 5. lector_auditoria: solo lectura de la auditoría (copia externa y verificación).
AUDIT_READER_DATABASE_URL=postgres://lector_auditoria:cambiar-esto@localhost:5432/plataforma_dev

# --- Acceso y sesiones (Auth.js) ----------------------------------------------
# Firma de sesiones y enlaces. Generar un valor largo y aleatorio distinto por entorno.
AUTH_SECRET=cambiar-esto

# --- Llaves de cifrado (D-048.4, RS-46) ---------------------------------------
# Llave maestra: vive FUERA de la base y FUERA de los respaldos. De ella se derivan
# las llaves por empresa (claves de licencia, secretos de webhook) y por usuario
# (semilla de la segunda verificación). Se rota una vez al año y ante sospecha.
# Si se pierde, las claves de licencia no se pueden recuperar: tiene respaldo
# aparte, en dos lugares, con al menos dos custodios (antes se llamaba FIELD_ENCRYPTION_KEY).
MASTER_ENCRYPTION_KEY=cambiar-esto
# Versión de la llave maestra vigente (permite rotar sin perder lo cifrado antes).
MASTER_ENCRYPTION_KEY_VERSION=1
# Llave con la que se cifran los respaldos propios. Distinta de la maestra.
BACKUP_ENCRYPTION_KEY=cambiar-esto

# --- Correo (D-054, sección 6 del plan) ----------------------------------------
# captura  = nada sale a internet; los correos quedan en una bandeja que QA puede leer.
# proveedor = envío real. SOLO en producción (y en pruebas de entrega controladas).
EMAIL_TRANSPORT=captura
# Dirección de la bandeja de captura (solo desarrollo y pruebas).
EMAIL_CAPTURE_URL=http://localhost:8025
# Envío real (producción): clave del proveedor y remitente en el subdominio verificado.
EMAIL_API_KEY=cambiar-esto
EMAIL_FROM=acceso@avisos.ejemplo.test
# Segundo proveedor de reserva (misma capa de envío, adaptador distinto).
EMAIL_BACKUP_API_KEY=cambiar-esto

# --- Respaldos propios (4.1 del plan) -----------------------------------------
# Almacenamiento externo, de OTRO proveedor y OTRA cuenta que la base de datos.
BACKUP_STORAGE_ENDPOINT=cambiar-esto
BACKUP_STORAGE_BUCKET=cambiar-esto
BACKUP_STORAGE_ACCESS_KEY=cambiar-esto
BACKUP_STORAGE_SECRET_KEY=cambiar-esto

# --- Copia externa de la auditoría (D-052.2, RF-AUD-018) ----------------------
# Escritura: SOLO puede agregar. La tiene el trabajo programado de copia.
AUDIT_COPY_ENDPOINT=cambiar-esto
AUDIT_COPY_BUCKET=cambiar-esto
AUDIT_COPY_WRITE_ACCESS_KEY=cambiar-esto
AUDIT_COPY_WRITE_SECRET_KEY=cambiar-esto
# Clave con la que se firma la cadena de huellas. NO está en la base de datos.
AUDIT_COPY_SIGNING_KEY=cambiar-esto
# Lectura: para verificar la copia. La tienen Seguridad / el Auditor de Cumplimiento,
# idealmente NO quien administra la base de producción.
AUDIT_COPY_READ_ACCESS_KEY=cambiar-esto
AUDIT_COPY_READ_SECRET_KEY=cambiar-esto

# --- Registro de anonimizaciones (D-032.3, D-052.3, RF-DAT-016) ---------------
# Almacén propio, FUERA de la base que se restaura. Solo guarda identificador y fecha.
ANON_REGISTRY_ENDPOINT=cambiar-esto
ANON_REGISTRY_BUCKET=cambiar-esto
ANON_REGISTRY_ACCESS_KEY=cambiar-esto
ANON_REGISTRY_SECRET_KEY=cambiar-esto

# --- Vigilancia (sección 7 del plan) -------------------------------------------
# Reporte de errores. Los datos personales y secretos se filtran ANTES de enviar.
ERROR_MONITORING_DSN=
# Direcciones de "latido": cada trabajo avisa "terminé bien"; si deja de avisar, hay alerta.
HEARTBEAT_URL_WORKER=
HEARTBEAT_URL_BACKUP=
HEARTBEAT_URL_AUDIT_COPY=

# --- Trabajos programados y pruebas -------------------------------------------
# Protege el disparo manual de los procesos diarios y las rutas de mantenimiento.
CRON_SECRET=cambiar-esto

# Reloj de la plataforma fijable (RNF-020). SOLO desarrollo y pruebas.
# En producción estas variables NO deben existir: la aplicación se niega a arrancar si las ve.
TEST_CLOCK_ENABLED=false
# Ejemplo de fecha fija (hora universal); déjalo vacío para usar el reloj real.
TEST_CLOCK_FIXED_AT=
