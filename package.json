{
  "name": "plataforma-ti-gestion",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de Gestión de Áreas de TI - Versión local 0.1 (solo datos inventados)",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verificar": "npm run typecheck && npm test && node scripts/buscar-secretos.mjs",
    "buscar:secretos": "node scripts/buscar-secretos.mjs",
    "db:generar": "node scripts/generar-prisma.mjs",
    "db:migrar": "node scripts/db.mjs migrar",
    "db:semilla": "node scripts/db.mjs semilla",
    "db:reiniciar": "node scripts/db.mjs reiniciar",
    "local": "node scripts/local.mjs",
    "probar:aislamiento": "vitest run --config vitest.base.config.mts pruebas/aislamiento",
    "probar:recorrido": "playwright test",
    "postinstall": "node scripts/generar-prisma.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
